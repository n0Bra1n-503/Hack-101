APP_NAME="SkyGuard AI Backend"
ENVIRONMENT=development
DATABASE_URL=sqlite:///./skyguard.db
LOG_LEVEL=INFO

# Supabase Operational PostgreSQL Configuration (Placeholders - Never commit actual credentials)
